# ==============================================================================
# Poster Application — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# 1. DO NOT commit actual credentials or the generated APP_KEY to source control.
# 2. APP_KEY is used to encrypt third-party credentials (WordPress Application Passwords
#    and Facebook Access Tokens) stored in the `integration_settings` table.
#    NEVER re-generate APP_KEY after saving integration credentials, otherwise they
#    cannot be decrypted!
# ==============================================================================

APP_NAME="Poster"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: Daily rotation to keep disk usage bounded
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poster
DB_USERNAME=poster_user
DB_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD"

# Session: Database driver for high security and multi-worker safety
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Filesystem: Local public disk served via Nginx with `php artisan storage:link`
FILESYSTEM_DISK=public

# Queue Configuration:
# - Driver: database
# - QUEUE_AUTO_TRIGGER: false on production (Supervisor manages worker daemons)
# - DB_QUEUE_RETRY_AFTER: 120s (matches maximum job timeout)
QUEUE_CONNECTION=database
QUEUE_AUTO_TRIGGER=false
DB_QUEUE_RETRY_AFTER=120

# Cache: Database store
CACHE_STORE=database

# Mail Configuration (Set up with your SMTP provider if needed)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security: Self-registration is disabled for production
REGISTRATION_ENABLED=false

# ------------------------------------------------------------------------------
# Integration Credentials Fallback (Optional)
# Credentials saved via UI in "Settings > Integrations" take precedence and are
# stored encrypted in the database. These environment variables serve as fallback.
# ------------------------------------------------------------------------------
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0

VITE_APP_NAME="${APP_NAME}"
